{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/tools/get_recovery_curves.schema.json",
  "title": "get_recovery_curves",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "../common/scope.schema.json" },
        "groupBy": { "enum": ["COLLECTOR", "COHORT", "COLLECTOR_COHORT"], "default": "COLLECTOR" },
        "maxMonths": { "type": "integer", "minimum": 1, "maximum": 24, "default": 12 }
      }
    },
    "output": {
      "type": "object",
      "required": ["meta", "months", "curves"],
      "additionalProperties": false,
      "properties": {
        "meta": { "$ref": "../common/meta.schema.json" },
        "months": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "curves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "n", "values"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "collector": { "$ref": "../common/defs.schema.json#/$defs/collector" },
              "cohort": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
              "n": { "type": "integer", "minimum": 0 },
              "values": {
                "type": "array",
                "description": "Recovery rate cumulato (0-1) per mese dall'inizio affido; null se il mese non e ancora osservabile.",
                "items": { "type": ["number", "null"] }
              },
              "ciLow": { "type": "array", "items": { "type": ["number", "null"] } },
              "ciHigh": { "type": "array", "items": { "type": ["number", "null"] } }
            }
          }
        }
      }
    }
  }
}
