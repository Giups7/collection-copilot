{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/tools/simulate_reassignment.schema.json",
  "title": "simulate_reassignment",
  "$defs": {
    "input": {
      "type": "object",
      "required": ["scope", "fromCollector", "toCollector"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "object",
          "allOf": [{ "$ref": "../common/scope.schema.json" }],
          "required": ["fasce"],
          "properties": { "fasce": { "type": "array", "minItems": 1 } },
          "description": "La simulazione richiede almeno una fascia."
        },
        "fromCollector": { "$ref": "../common/defs.schema.json#/$defs/collector" },
        "toCollector": { "$ref": "../common/defs.schema.json#/$defs/collector" },
        "kpi": { "$ref": "../common/defs.schema.json#/$defs/kpiCode", "default": "RR_90" }
      }
    },
    "output": {
      "type": "object",
      "required": ["meta", "actualRecovered", "estimatedRecovered", "difference", "ci", "assumptions"],
      "additionalProperties": false,
      "properties": {
        "meta": { "$ref": "../common/meta.schema.json" },
        "actualRecovered": { "type": "number" },
        "estimatedRecovered": { "type": "number" },
        "difference": { "type": "number" },
        "ci": { "$ref": "../common/defs.schema.json#/$defs/confidenceInterval", "description": "Intervallo della differenza." },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["CAPACITY_UNLIMITED", "SAME_PERFORMANCE_AT_HIGHER_VOLUME", "MIX_FROM_SOURCE"] }
        },
        "insufficient": { "type": "boolean", "description": "True se uno dei due recuperatori e sotto il volume minimo: la stima non va presentata come affidabile." }
      }
    }
  }
}
