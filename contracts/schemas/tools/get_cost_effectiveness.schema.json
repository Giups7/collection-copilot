{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/tools/get_cost_effectiveness.schema.json",
  "title": "get_cost_effectiveness",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "../common/scope.schema.json" }
      }
    },
    "output": {
      "type": "object",
      "required": ["meta", "available", "cells"],
      "additionalProperties": false,
      "properties": {
        "meta": { "$ref": "../common/meta.schema.json" },
        "available": { "type": "boolean", "description": "False se i dati sulle provvigioni non sono disponibili (D-35)." },
        "reason": { "type": "string" },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["collector", "fascia", "n", "recovered", "commissions", "costRatio", "netRecovery"],
            "additionalProperties": false,
            "properties": {
              "collector": { "$ref": "../common/defs.schema.json#/$defs/collector" },
              "fascia": { "$ref": "../common/defs.schema.json#/$defs/fascia" },
              "n": { "type": "integer", "minimum": 0 },
              "recovered": { "type": "number" },
              "commissions": { "type": "number" },
              "costRatio": { "type": "number", "description": "Provvigioni / incassato." },
              "netRecovery": { "type": "number", "description": "Incassato - provvigioni." }
            }
          }
        }
      }
    }
  }
}
