{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/tools/compare_collectors.schema.json",
  "title": "compare_collectors",
  "$defs": {
    "input": {
      "type": "object",
      "required": ["collectors", "fascia"],
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "../common/scope.schema.json" },
        "fascia": { "$ref": "../common/defs.schema.json#/$defs/fascia" },
        "collectors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "../common/defs.schema.json#/$defs/collector" }
        },
        "kpis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../common/defs.schema.json#/$defs/kpiCode" },
          "default": ["RR_90", "CURE_RATE", "FIRST_PAY_DAYS"]
        },
        "mixAdjusted": { "type": "boolean", "default": true }
      }
    },
    "output": {
      "type": "object",
      "required": ["meta", "fascia", "rows"],
      "additionalProperties": false,
      "properties": {
        "meta": { "$ref": "../common/meta.schema.json" },
        "fascia": { "$ref": "../common/defs.schema.json#/$defs/fascia" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["collector", "n", "metrics"],
            "additionalProperties": false,
            "properties": {
              "collector": { "$ref": "../common/defs.schema.json#/$defs/collector" },
              "n": { "type": "integer", "minimum": 0 },
              "insufficient": { "type": "boolean" },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kpi"],
                  "additionalProperties": false,
                  "properties": {
                    "kpi": { "$ref": "../common/defs.schema.json#/$defs/kpiCode" },
                    "value": { "type": ["number", "null"] },
                    "ci": { "$ref": "../common/defs.schema.json#/$defs/confidenceInterval" },
                    "index": { "type": "number" },
                    "indexCi": { "$ref": "../common/defs.schema.json#/$defs/confidenceInterval" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
