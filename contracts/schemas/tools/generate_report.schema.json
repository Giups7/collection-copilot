{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/tools/generate_report.schema.json",
  "title": "generate_report",
  "$defs": {
    "input": {
      "type": "object",
      "required": ["title", "format", "sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "format": { "enum": ["PDF", "XLSX"] },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "Ogni sezione riesegue un tool di analisi con i suoi parametri: i numeri del report vengono dai tool, non dall'LLM.",
          "items": {
            "type": "object",
            "required": ["tool", "input"],
            "additionalProperties": false,
            "properties": {
              "heading": { "type": "string" },
              "tool": {
                "enum": [
                  "get_portfolio_summary",
                  "get_recovery_trend",
                  "get_portfolio_distribution",
                  "get_collector_performance",
                  "compare_collectors",
                  "rank_collectors_by_band",
                  "get_recovery_curves",
                  "get_band_migration",
                  "get_cost_effectiveness",
                  "get_insights",
                  "detect_anomalies",
                  "forecast_recoveries",
                  "get_data_quality_report"
                ]
              },
              "input": { "type": "object" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["fileId", "format", "name", "sections"],
      "additionalProperties": false,
      "properties": {
        "fileId": { "type": "string" },
        "format": { "enum": ["PDF", "XLSX"] },
        "name": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 1 },
        "asOf": { "$ref": "../common/defs.schema.json#/$defs/isoDate" }
      }
    }
  }
}
