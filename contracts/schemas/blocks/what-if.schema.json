{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/blocks/what-if.schema.json",
  "title": "WhatIfBlock",
  "description": "Risultato di una simulazione. Le avvertenze vanno sempre mostrate, mai nascoste in un tooltip.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json" }],
  "required": ["question", "actual", "estimated", "difference", "ci", "assumptions"],
  "properties": {
    "type": { "const": "whatIf" },
    "question": { "type": "string" },
    "actual": { "type": "number" },
    "estimated": { "type": "number" },
    "difference": { "type": "number" },
    "ci": { "$ref": "../common/defs.schema.json#/$defs/confidenceInterval" },
    "unit": { "$ref": "../common/defs.schema.json#/$defs/unit" },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["CAPACITY_UNLIMITED", "SAME_PERFORMANCE_AT_HIGHER_VOLUME", "MIX_FROM_SOURCE"] }
    }
  },
  "unevaluatedProperties": false
}
