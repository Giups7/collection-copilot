{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/blocks/table.schema.json",
  "title": "TableBlock",
  "description": "Le righe non viaggiano nel blocco: il client le carica a pagine da GET /v1/copilot/data/{dataSourceId}.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json" }],
  "required": ["dataSourceId", "columns", "totalRows"],
  "properties": {
    "type": { "const": "table" },
    "dataSourceId": { "type": "string", "minLength": 1 },
    "totalRows": { "type": "integer", "minimum": 0 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "enum": ["string", "number", "currency", "percent", "date"] }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
