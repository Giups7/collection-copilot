{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.collection-copilot.local/v1/api/conversation.schema.json",
  "title": "Conversation",
  "description": "Risposta di GET /v1/copilot/conversations/{conversationId}.",
  "type": "object",
  "required": ["conversationId", "turns"],
  "additionalProperties": false,
  "properties": {
    "conversationId": { "type": "string" },
    "createdAt": { "$ref": "../common/defs.schema.json#/$defs/isoDateTime" },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requestId", "message"],
        "additionalProperties": false,
        "properties": {
          "requestId": { "type": "string" },
          "message": { "type": "string", "description": "Domanda dell'utente." },
          "result": { "$ref": "copilot-result.schema.json" }
        }
      }
    }
  }
}
